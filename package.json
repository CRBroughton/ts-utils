{
  "name": "@crbroughton/ts-utils",
  "version": "2.0.0",
  "description": "A collection of helper functions and types",
  "author": "Craig R Broughton",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crbroughton/ts-utils.git"
  },
  "keywords": [
    "typescript",
    "types",
    "enum",
    "exceptions",
    "async",
    "utility",
    "bun"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --skipLibCheck --noEmit",
    "build": "bun run typecheck && npx tsc --project tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "changeset": "npx changeset",
    "changeset:status": "npx changeset status --verbose",
    "changeset:version": "npx changeset version",
    "publish": "bun run build && npm publish --access=public",
    "deps:update": "bunx taze -I"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@antfu/eslint-config": "2.14.0",
    "@changesets/cli": "^2.29.8",
    "@crbroughton/ts-test-utils": "^0.7.0",
    "@faker-js/faker": "^10.3.0",
    "@types/bun": "1.1.8",
    "eslint": "9.0.0"
  }
}
