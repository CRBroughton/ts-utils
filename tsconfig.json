{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "declaration": true,
    "outDir": "dist",
    "removeComments": false,
    "stripInternal": false,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": ["./index.ts"],
  "exclude": ["node_modules", "dist"]
}
